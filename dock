def sh(args, cwd=None, check=True):
    r = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    if check and r.returncode:
        raise RuntimeError((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else f"exit {r.returncode}")
    return r


# ---- docker ------------------------------------------------------------------------------

def inspect_all():
    """Every container on the machine, as {name: info}. One `docker inspect` covers them all."""
    ids = sh(["docker", "ps", "-aq"]).stdout.split()
    if not ids:
        return {}
    out = {}
    for c in json.loads(sh(["docker", "inspect", *ids]).stdout):
        st = c["State"]
        out[c["Name"].lstrip("/")] = {
            "name": c["Name"].lstrip("/"),
            "id": c["Id"],
            "image_id": c["Image"],
            "service": (c["Config"].get("Labels") or {}).get("com.docker.compose.service"),
            "running": st["Status"] == "running",
            "state": st["Status"],
            "health": (st.get("Health") or {}).get("Status"),
            "started": st["StartedAt"] if st["Status"] == "running" else None,
            "finished": st["FinishedAt"] if st["Status"] != "running" else None,
            "error": st.get("Error") or None,
            "exit": st.get("ExitCode"),
            "restarts": c.get("RestartCount", 0),
            "image": c["Config"]["Image"],
            "project": (c["Config"].get("Labels") or {}).get("com.docker.compose.project"),
            "workdir": (c["Config"].get("Labels") or {}).get("com.docker.compose.project.working_dir"),
            # PortBindings survive a stop, unlike the live port list, so links work while an app is off.
            "binds": {int(b["HostPort"]): b["HostIp"] or "0.0.0.0"
                      for bs in (c["HostConfig"].get("PortBindings") or {}).values() for b in bs or [] if b.get("HostPort")},
        }
    return out


def members(app, every):
    spec = APPS[app]
    if "compose" in spec:
        return [c for c in every.values() if c["project"] == spec["compose"]["project"]]
    return [every[n] for n in spec["containers"] if n in every]


def status(app, every=None):
    cs = members(app, every if every is not None else inspect_all())
    up = sum(c["running"] for c in cs)
    state = "missing" if not cs else "on" if up == len(cs) else "off" if up == 0 else "partial"
    return {"state": state, "running": up, "total": len(cs), "down": [c["name"] for c in cs if not c["running"]]}


def compose_cmd(spec):
    c = spec["compose"]
    d = os.path.expanduser(c["dir"])
    return ["docker", "compose", "-p", c["project"], "--project-directory", d, "-f", os.path.join(d, c["file"])], d


def app_dir(spec):
    return compose_cmd(spec)[1] if "compose" in spec else None


def turn(app, action):
    """action: on | off | restart | update"""
    spec = APPS[app]
    if action == "update":
        return update(app)
    t0 = time.time()
    if "containers" in spec:
        sh(["docker", {"on": "start", "off": "stop", "restart": "restart"}[action], *spec["containers"]])
    else:
        base, d = compose_cmd(spec)
        if action == "off":
            sh([*base, "stop"])
        elif action == "restart":
            sh([*base, "restart"])
        elif (cs := members(app, inspect_all())) and not moved(cs, d):
            sh([*base, "start"])
        elif "up" in spec:
            sh(["bash", "-c", spec["up"]], cwd=d)
        else:
            sh([*base, "up", "-d"])
    if action in ("on", "restart"):
        check_started(app, t0)
    if action != "off" and "after_start" in spec:
        sh(["bash", "-c", os.path.expanduser(spec["after_start"])], cwd=app_dir(spec))


def moved(cs, d):
    """True when the app's containers were made from a folder that's since moved. `compose start` would
    reuse them as they are, still pointing at the old folder, and they'd die straight away (VoiceStudio
    did this after docker-master became linux-remote), so they're recreated from the new one instead."""
    return any(c["workdir"] and os.path.realpath(c["workdir"]) != os.path.realpath(d) for c in cs)


START_CHECK = 5  # seconds a just-started app gets before a stopped container counts as a crash


def check_started(app, since):
    """Raises if a container stopped with an error right after starting, or Docker keeps restarting it.
    Otherwise a crashing app just goes back to looking "off" and the switch seems to do nothing."""
    time.sleep(START_CHECK)
    after = datetime.fromtimestamp(since, timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")  # Docker's times are UTC
    for c in members(app, inspect_all()):
        if c["state"] == "restarting":
            raise RuntimeError(f"{c['name']} keeps crashing and restarting; its logs should say why")
        if c["state"] in ("exited", "dead") and c["exit"] and (c["finished"] or "") >= after:
            raise RuntimeError(f"{c['name']} stopped right after starting (code {c['exit']}); its logs should say why")


def update(app):
    """Pull newer images and recreate the app's containers. Volumes and data are kept. Services that were
    running come back running; stopped ones are recreated but stay stopped, and never-created ones stay
    uncreated. An app with an `up:` command is recreated through it, because that command loads keys
    its compose file needs, so all of that app comes back running."""
    spec = APPS[app]
    if "compose" not in spec:
        raise RuntimeError("only compose apps can be updated here")
    base, d = compose_cmd(spec)
    cs = members(app, inspect_all())
    running = sorted({c["service"] for c in cs if c["running"] and c["service"]})
    stopped = sorted({c["service"] for c in cs if not c["running"] and c["service"]} - set(running))
    sh([*base, "pull", "--ignore-buildable", "--quiet", *running, *stopped])
    if "up" in spec:
        sh(["bash", "-c", spec["up"]], cwd=d)
    else:
        if running:
            sh([*base, "up", "-d", "--no-deps", *running])
        if stopped:
            sh([*base, "up", "--no-start", "--no-deps", *stopped])
    _repo_digests.clear()
    _df["at"] = 0
    if (running or "up" in spec) and "after_start" in spec:
        sh(["bash", "-c", os.path.expanduser(spec["after_start"])], cwd=d)


def gpu_clash(app, every, gpu=False):
    """Who else is on the GPU when `app` (a `gpu: true` app) starts: other GPU apps that are on, and
    programs outside Docker holding memory on the card (the VoiceStudio desktop app, say)."""
    if not APPS[app].get("gpu"):
        return []
    out = [APPS[a].get("label", a) for a in APPS
           if a != app and APPS[a].get("gpu") and status(a, every)["state"] in ("on", "partial")]
    for u in ((gpu_stats(every) if gpu is False else gpu) or {}).get("users", []):
        if u["app"] is None and u["label"] not in out:
            out.append(u["label"])
    return out


def owner(container, every):
    """The app a container belongs to, or None."""
    return next((a for a in APPS if any(c["name"] == container for c in members(a, every))), None)


ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def logs(container, lines=200):
    r = sh(["docker", "logs", "--tail", str(lines), "--timestamps", container], check=False)
    return ANSI.sub("", r.stdout + r.stderr)


def resolve(name):
    if name == "all":
        return list(APPS)
    if name not in APPS:
        sys.exit(f"unknown app '{name}'. Known: {', '.join(APPS)}")
    return [name]


# ---- tailscale + links -------------------------------------------------------------------

_ts = {"at": 0.0, "host": None, "ips": [], "serve": {}}


def tailscale():
    """{host, ips, serve: {local port: https url}}, refreshed every 15 s. If the CLI fails (tailscaled
    still starting after a boot) the last good answer stays, and with none yet it retries on every call."""
    if _ts["host"] and time.time() - _ts["at"] < 15:
        return _ts
    try:
        me = json.loads(sh(["tailscale", "status", "--json"]).stdout)["Self"]
        host, ips, serve = me["DNSName"].rstrip("."), me.get("TailscaleIPs", []), {}
        web = json.loads(sh(["tailscale", "serve", "status", "--json"]).stdout or "{}").get("Web") or {}
        for hostport, cfg in web.items():
            target = urlparse(((cfg.get("Handlers") or {}).get("/") or {}).get("Proxy", ""))
            if target.port and target.hostname in ("127.0.0.1", "localhost", *ips):
                serve[target.port] = "https://" + hostport.removesuffix(":443") + "/"
        _ts.update(at=time.time(), host=host, ips=ips, serve=serve)
    except Exception:
        pass
    return _ts


def links(app, every):
    """Each web page of the app with the URL to use on the phone (None if PC only) and on the PC."""
    ts, cs = tailscale(), members(app, every)
    out = []
    for w in APPS[app].get("web", []):
        port = int(w["port"])
        # `upstream:` = the page on `port` is a gate (lock, key) in front of the container's own port.
        app_port = int(w.get("upstream", port))
        holder = next((c for c in cs if app_port in c["binds"]), None)
        bind = "127.0.0.1" if "upstream" in w else holder["binds"][port] if holder else None
        phone = ts["serve"].get(port)
        if not phone and ts["host"] and bind in ("0.0.0.0", *ts["ips"]):
            phone = f"http://{ts['host']}:{port}/"
        pc = f"http://{'localhost' if bind in (None, '0.0.0.0', '127.0.0.1') else bind}:{port}/"
        if w.get("pc") == "tailnet" and phone:  # the app only works on its tailnet address
            pc = phone
        out.append({"label": w["label"], "port": port, "phone": phone, "pc": pc,
                    "up": bool(holder and holder["running"]), "exists": holder is not None})
    return out


# ---- host stats --------------------------------------------------------------------------

_cpu = {"prev": None}


def cpu_percent():
    """Busy share of all cores since the previous call."""
    vals = list(map(int, Path("/proc/stat").read_text().split("\n", 1)[0].split()[1:]))
    idle, total = vals[3] + vals[4], sum(vals)
    prev, _cpu["prev"] = _cpu["prev"], (idle, total)
    if not prev or total == prev[1]:
        return None
    return round(100 * (1 - (idle - prev[0]) / (total - prev[1])), 1)


def backup_stats():
    """How old the last good backup is, or None if apps.yaml names no status file."""
    path = PANEL.get("backup_status")
    if not path:
        return None
    try:
        path = Path(path).expanduser()
        return {"age": time.time() - path.stat().st_mtime, "warnings": len(json.loads(path.read_text())["warnings"])}
    except (OSError, ValueError, KeyError):
        return {"age": None, "warnings": 0}


MIB = 1024 ** 2


def _num(s):
    try:
        return int(float(s))
    except ValueError:  # nvidia-smi prints [N/A] for what a card can't report
        return None


def gpu_user(pid, every):
    """(app id, label) for a process on the GPU: the app owning its container, else the program's name.
    A program under /opt/<Name>/ is named after that folder (the VoiceStudio desktop app is /opt/VoiceStudio)."""
    try:
        cg = Path(f"/proc/{pid}/cgroup").read_text()
    except OSError:
        return None, f"process {pid}"
    m = re.search(r"docker[-/]([0-9a-f]{64})", cg)
    if m:
        c = next((c for c in every.values() if c["id"] == m.group(1)), None)
        app = c and owner(c["name"], every)
        if app:
            return app, APPS[app].get("label", app)
        return None, f"container {c['name']}" if c else "a container"
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        exe = ""
    top = re.match(r"/opt/([^/]+)/", exe)
    if top:
        return None, f"{top.group(1)} (outside Docker)"
    try:
        return None, Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return None, f"process {pid}"


def gpu_stats(every):
    """The card's memory, load and temperature, and who holds memory on it. None without an NVIDIA card."""
    if not shutil.which("nvidia-smi"):
        return None
    q = ["nvidia-smi", "--format=csv,noheader,nounits"]
    r = sh([*q, "--query-gpu=name,memory.used,memory.total,utilization.gpu,temperature.gpu"], check=False)
    if r.returncode or not r.stdout.strip():
        return None
    name, used, total, util, temp = (x.strip() for x in r.stdout.splitlines()[0].split(","))
    users = {}
    for line in sh([*q, "--query-compute-apps=pid,used_memory"], check=False).stdout.splitlines():
        pid, mem = (x.strip() for x in line.split(","))
        app, label = gpu_user(pid, every)
        u = users.setdefault(label, {"app": app, "label": label, "mem": 0})
        u["mem"] += (_num(mem) or 0) * MIB
    return {"name": name, "used": (_num(used) or 0) * MIB, "total": (_num(total) or 0) * MIB,
            "util": _num(util), "temp": _num(temp), "users": sorted(users.values(), key=lambda u: -u["mem"])}


UNITS = {"B": 1, "KB": 1e3, "MB": 1e6, "GB": 1e9, "TB": 1e12, "KIB": 1024, "MIB": 1024 ** 2, "GIB": 1024 ** 3, "TIB": 1024 ** 4}


def _bytes(s):
    """Docker's '24.6GB' / '476.8kB' / '31.26MiB' / '0B' as bytes; 0 if it can't be read."""
    m = re.match(r"([\d.]+)\s*([kKMGT]?i?B)", s or "")
    return int(float(m.group(1)) * UNITS[m.group(2).upper()]) if m else 0


_df = {"at": 0.0, "val": None}


def docker_disk():
    """Image and build-cache space, which images no container uses, and each image's build date.
    Refreshed once a minute (the two `docker system df` calls take ~0.1 s)."""
    if _df["val"] and time.time() - _df["at"] < 60:
        return _df["val"]
    try:
        summary = {d["Type"]: d for d in map(json.loads, sh(["docker", "system", "df", "--format", "{{json .}}"]).stdout.splitlines())}
        images = json.loads(sh(["docker", "system", "df", "-v", "--format", "{{json .}}"]).stdout).get("Images") or []
    except (RuntimeError, ValueError, KeyError):
        return _df["val"]
    unused = [i for i in images if str(i.get("Containers")) == "0"]
    created = {}
    for i in images:
        try:  # "2026-11-03 19:53:23 -0500 EST"
            created[i["ID"]] = datetime.strptime(i["CreatedAt"][:25], "%Y-%m-%d %H:%M:%S %z").isoformat()
        except (KeyError, ValueError):
            pass
    _df.update(at=time.time(), val={
        "images": _bytes(summary.get("Images", {}).get("Size")),
        "count": len(images),
        # Unique size is what removing the image frees; layers shared with an image in use stay.
        "unused": len(unused), "unused_bytes": sum(_bytes(i.get("UniqueSize")) for i in unused),
        "cache": _bytes(summary.get("Build Cache", {}).get("Size")),
        "created": created,
    })
    return _df["val"]


# ---- image updates -----------------------------------------------------------------------
# The registry is asked with HEAD requests only. Docker Hub doesn't count those against its pull limit,
# so checking never uses up the pulls a real `docker pull` needs.

MANIFESTS = ", ".join([
    "application/vnd.oci.image.index.v1+json", "application/vnd.docker.distribution.manifest.list.v2+json",
    "application/vnd.docker.distribution.manifest.v2+json", "application/vnd.oci.image.manifest.v1+json"])


def parse_ref(ref):
    """'lscr.io/linuxserver/lidarr:latest' -> ('lscr.io', 'linuxserver/lidarr', 'latest'); Docker Hub names get its host."""
    name, tag = ref, "latest"
    if ":" in name.rsplit("/", 1)[-1]:
        name, tag = name.rsplit(":", 1)
    first = name.split("/", 1)[0]
    if "/" in name and ("." in first or ":" in first or first == "localhost"):
        reg, repo = name.split("/", 1)
    else:
        reg, repo = "registry-1.docker.io", name if "/" in name else "library/" + name
    return reg, repo, tag


def remote_digest(ref):
    """The digest the registry serves for this tag now, using an anonymous token when the registry wants one."""
    reg, repo, tag = parse_ref(ref)
    url = f"https://{reg}/v2/{repo}/manifests/{tag}"

    def head(token=None):
        h = {"Accept": MANIFESTS, "User-Agent": "dock-update-check"}
        if token:
            h["Authorization"] = "Bearer " + token
        return urlopen(Request(url, method="HEAD", headers=h), timeout=15)

    try:
        r = head()
    except HTTPError as e:
        if e.code != 401:
            raise
        p = dict(re.findall(r'(\w+)="([^"]*)"', e.headers.get("WWW-Authenticate", "")))
        q = urlencode({"service": p.get("service", reg), "scope": p.get("scope") or f"repository:{repo}:pull"})
        t = json.load(urlopen(p["realm"] + "?" + q, timeout=15))
        r = head(t.get("token") or t.get("access_token"))
    return r.headers.get("Docker-Content-Digest")


_repo_digests = {}  # image id -> the registry digests it was pulled as ([] for an image built here)


def repo_digests(image_id):
    if image_id not in _repo_digests:
        r = sh(["docker", "image", "inspect", "--format", "{{json .RepoDigests}}", image_id], check=False)
        try:
            _repo_digests[image_id] = [d.split("@", 1)[1] for d in json.loads(r.stdout) or [] if "@" in d]
        except ValueError:
            return []
    return _repo_digests[image_id]


updates = {"at": None, "remote": {}, "errors": {}}  # remote: image ref -> digest the registry has now


def check_updates():
    """Ask the registry about every image a listed app's containers use. Images built on this machine are skipped."""
    every = inspect_all()
    refs = {c["image"] for a in APPS for c in members(a, every)
            if "@" not in c["image"] and not c["image"].startswith("sha256:") and repo_digests(c["image_id"])}
    remote, errors = {}, {}
    for ref in sorted(refs):
        try:
            remote[ref] = remote_digest(ref)
        except Exception as e:  # offline, or the registry is down: keep the last answer for this one
            errors[ref] = str(e)
            if ref in updates["remote"]:
                remote[ref] = updates["remote"][ref]
    updates.update(at=time.time(), remote=remote, errors=errors)


def has_update(c):
    """True if the registry has a newer image than the one this container runs, None if unknown."""
    want = updates["remote"].get(c["image"])
    have = repo_digests(c["image_id"])
    if not want or not have:
        return None
    return want not in have


def updates_loop():
    time.sleep(30)  # let the panel and tailscale settle after a boot
    while True:
        try:
            check_updates()
        except Exception as e:
            print(f"update check failed: {e}", flush=True)
        time.sleep(12 * 3600)


_mem = {"at": 0.0, "val": []}


FRIENDLY = [(r"/claude/versions/", "Claude Code"), (r"/node$", "Node.js"), (r"^gnome-shell$|/gnome-shell$", "Desktop (GNOME)")]


def program_name(pid, comm):
    """A person-friendly name for a process outside Docker: its PROGRAMS label, a known name, its /opt folder, or its file."""
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        exe = ""
    for n, spec in PROGRAMS.items():
        if spec.get("process") and (spec["process"] in exe or spec["process"] == comm):
            return spec.get("label", n)
    for pattern, label in FRIENDLY:
        if re.search(pattern, exe or comm):
            return label
    folder = re.match(r"/opt/([^/]+)/", exe)
    if folder and folder.group(1) != "google":
        return folder.group(1)
    # Threads rename themselves (Node's is "MainThread"), so the program file names it better.
    return Path(exe).name if exe else comm


def memory_by_program(limit=6):
    """The biggest programs outside Docker by memory, so the panel can say where the rest of the RAM goes.
    PSS (proportional set size) splits memory shared between processes, so Chrome's dozens of
    processes add up to what Chrome really holds instead of several times that."""
    if time.time() - _mem["at"] < 10:
        return _mem["val"]
    totals = {}
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            if re.search(r"docker|containerd|libpod", (d / "cgroup").read_text()):
                continue  # counted per app from docker stats
            comm = (d / "comm").read_text().strip()
            try:
                kb = next(int(l.split()[1]) for l in (d / "smaps_rollup").read_text().splitlines() if l.startswith("Pss:"))
            except (OSError, StopIteration):  # other users' processes: resident size is the best we can read
                kb = int((d / "statm").read_text().split()[1]) * os.sysconf("SC_PAGE_SIZE") // 1024
        except (OSError, ValueError, IndexError):
            continue  # exited meanwhile, or a kernel thread
        if kb:
            name = program_name(d.name, comm)
            # A sandboxed helper's file can't be read, so it shows as e.g. "open-whispr-app"; fold it into "OpenWhispr".
            same_program = re.sub(r"app$", "", re.sub(r"[^a-z]", "", name.lower()))
            label, total = totals.get(same_program, (name, 0))
            totals[same_program] = (label if label[:1].isupper() else name, total + kb * 1024)
    biggest = sorted(({"label": label, "bytes": n} for label, n in totals.values() if n >= 50 * MIB), key=lambda x: -x["bytes"])[:limit]
    _mem.update(at=time.time(), val=biggest)
    return biggest


def host_stats(every):
    mem = {l.split(":")[0]: int(l.split()[1]) * 1024 for l in Path("/proc/meminfo").read_text().splitlines()}
    disks = []
    for d in PANEL.get("disks", [{"label": "System", "path": "/"}]):
        try:
            u = shutil.disk_usage(d["path"])
            disks.append({"label": d["label"], "used": u.used, "total": u.total})
        except OSError:
            pass
    return {
        "name": os.uname().nodename,
        "uptime": float(Path("/proc/uptime").read_text().split()[0]),
        "load": os.getloadavg(),
        "cores": os.cpu_count(),
        "cpu": cpu_percent(),
        "mem": {"used": mem["MemTotal"] - mem["MemAvailable"], "total": mem["MemTotal"], "programs": memory_by_program()},
        "disks": disks,
        "tailscale": tailscale()["host"],
        "backup": backup_stats(),
        "gpu": gpu_stats(every),
        "docker": {k: v for k, v in (docker_disk() or {}).items() if k != "created"} or None,
        "updates_checked": updates["at"],
    }


# Per-container CPU and memory. `docker stats` takes ~2 s, so a background thread keeps it fresh,
# but only while someone has the panel open.
stats = {}
last_poll = [0.0]


def stats_loop():
    while True:
        if time.time() - last_poll[0] < 20:
            try:
                r = sh(["docker", "stats", "--no-stream", "--format", "{{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}"], check=False)
                fresh = {}
                for line in r.stdout.splitlines():
                    with contextlib.suppress(ValueError):  # a container mid-start can print a short line
                        name, cpu, mem = line.split("\t")
                        used = mem.split(" / ")[0]
                        fresh[name] = {"cpu": cpu, "mem": used, "mem_bytes": _bytes(used)}
                stats.clear(); stats.update(fresh)
            except Exception as e:  # keep the thread alive; the panel just shows older numbers
                print(f"stats failed: {e}", flush=True)
        time.sleep(4)


# ---- desktop programs ---------------------------------------------------------------------
# Programs that aren't Docker apps but are handy to open from the phone, mainly Chrome so Claude
# can browse while nobody is at the PC. They open on the logged-in desktop, so the PC must be
# logged in (a locked screen is fine).

def desktop_env():
    """This shell's env, plus the desktop's DISPLAY and D-Bus when it lacks them (ssh, cron, cloud shells)."""
    env = dict(os.environ)
    if env.get("DISPLAY") or env.get("WAYLAND_DISPLAY"):
        return env
    r = sh(["systemctl", "--user", "show-environment"], check=False)
    for line in r.stdout.splitlines():
        k, _, v = line.partition("=")
        if k in ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR"):
            env.setdefault(k, v)
    return env


WRAPPERS = {"bash", "sh", "dash", "zsh", "fish", "python3", "timeout", "sudo"}


def _started_ticks(pid):
    """When a process started, in clock ticks since boot."""
    return int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19])


def program_pids(spec):
    """PIDs matching `process` (a pattern on the command line) or `exe` (the start of the program file's
    path, for apps whose main process rewrites its command line), oldest first. Skips shells and
    wrappers, whose command line can quote the pattern."""
    if spec.get("exe"):
        found = []
        for d in Path("/proc").iterdir():
            with contextlib.suppress(OSError):
                if d.name.isdigit() and os.readlink(d / "exe").startswith(spec["exe"]):
                    found.append(d.name)
    else:
        found = sh(["pgrep", "-f", spec["process"]], check=False).stdout.split()
    pids = []
    for pid in found:
        try:
            if Path(f"/proc/{pid}/comm").read_text().strip() in WRAPPERS:
                continue
            started = _started_ticks(pid)
        except (OSError, ValueError, IndexError):
            continue  # exited meanwhile
        pids.append((started, int(pid)))
    return [pid for _, pid in sorted(pids)]


def program_age(spec):
    """Seconds since the program's main process started; None when it isn't running."""
    pids = program_pids(spec)
    if not pids:
        return None
    try:
        boot = next(int(l.split()[1]) for l in Path("/proc/stat").read_text().splitlines() if l.startswith("btime "))
        return time.time() - (boot + _started_ticks(pids[0]) / os.sysconf("SC_CLK_TCK"))
    except (OSError, ValueError, IndexError, StopIteration):
        return None


def idle_seconds():
    """How long the PC's keyboard and mouse have sat untouched, from GNOME. None when it can't tell
    (logged out, or not GNOME), and then nothing closes for being idle."""
    try:
        r = subprocess.run(["gdbus", "call", "--session", "--dest", "org.gnome.Mutter.IdleMonitor",
                            "--object-path", "/org/gnome/Mutter/IdleMonitor/Core",
                            "--method", "org.gnome.Mutter.IdleMonitor.GetIdletime"],
                           env=desktop_env(), capture_output=True, text=True, timeout=5)
        return int(r.stdout.split()[1].rstrip(",)")) / 1000 if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, ValueError, IndexError):
        return None


def idle_left(spec, idle):
    """Seconds until a `close_when_idle_minutes` program closes for idleness, or None if it has no such limit.
    The clock starts at the later of the last key or mouse touch and the program's own start, so one
    opened from the phone while nobody is at the PC still gets the full time."""
    limit = spec.get("close_when_idle_minutes")
    if not limit or idle is None:
        return None
    age = program_age(spec)
    if age is None:
        return None
    return max(0, int(float(limit) * 60 - min(idle, age)))


def program_running(spec):
    return bool(program_pids(spec))


# Programs with `close_after_hours` close themselves that long after the panel or `dock open` opened
# them, so a forgotten Chrome doesn't sit on memory. One already open (say, from the PC's own menu)
# gets no timer: it's someone's, and closing it would lose their work.
TIMERS = Path.home() / ".local/state/dock/program-timers.json"
STARTUP_GRACE = 120  # seconds a just-launched program gets to show up before "not running" means closed


@contextlib.contextmanager
def edit_timers():
    """The timers, locked against the panel's threads and other `dock` runs; saved on exit.
    Each entry is {"at": close time, "set": when the timer started}."""
    TIMERS.parent.mkdir(parents=True, exist_ok=True)
    with open(TIMERS.with_suffix(".lock"), "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        t = timers()
        before = json.dumps(t, sort_keys=True)
        yield t
        if json.dumps(t, sort_keys=True) != before:
            tmp = TIMERS.with_suffix(".tmp")
            tmp.write_text(json.dumps(t))
            os.replace(tmp, TIMERS)  # atomic, so a reader never sees a half-written file


def timers():
    try:
        return json.loads(TIMERS.read_text())
    except (OSError, ValueError):
        return {}


def push_back(name, seconds=3600):
    with edit_timers() as t:
        if name not in t:
            raise RuntimeError(f"{name} has no auto-close timer")
        t[name]["at"] = max(t[name]["at"], time.time()) + seconds


def timers_loop():
    while True:
        try:
            close_due()
        except Exception as e:  # keep the thread alive, or nothing auto-closes until the panel restarts
            print(f"auto-close check failed: {e}", flush=True)
        time.sleep(60)


def close_due():
    """Closes programs whose timer is up, or that sat unused past their idle limit."""
    due = []
    with edit_timers() as t:
        for name, entry in list(t.items()):
            spec = PROGRAMS.get(name)
            if not spec or not isinstance(entry, dict):
                del t[name]
            elif not program_running(spec):
                if time.time() - entry["set"] > STARTUP_GRACE:
                    del t[name]  # closed by hand, so the timer is moot
            elif time.time() >= entry["at"]:
                due.append(name)
    idle = idle_seconds()
    for name, spec in PROGRAMS.items():
        if name not in due and idle_left(spec, idle) == 0:
            print(f"{name}: PC idle {int(idle // 60)} min", end="; ", flush=True)
            due.append(name)
    for name in due:
        print(f"auto-closing {name}", flush=True)
        close_program(name)


def open_program(name):
    """False when it was already open, so nothing was launched."""
    spec = PROGRAMS[name]
    if program_running(spec):
        return False
    env = desktop_env()
    if not (env.get("DISPLAY") or env.get("WAYLAND_DISPLAY")):
        raise RuntimeError("no desktop session; log in on the PC first")
    # Its own session, so restarting the panel doesn't take the program down with it.
    subprocess.Popen(["gtk-launch", spec["launch"]], env=env, start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if spec.get("close_after_hours"):
        now = time.time()
        with edit_timers() as t:
            t[name] = {"at": now + float(spec["close_after_hours"]) * 3600, "set": now}
    return True


def close_program(name):
    # The oldest matching process is the main one; a polite TERM lets it save tabs and quit cleanly.
    spec = PROGRAMS[name]
    pids = program_pids(spec)
    worker = None
    if pids:
        # Taken now: once the main one exits, its helpers lose their parent. Every other match is
        # added too, in case a helper was started some other way (D-Bus, a re-parented child).
        family = process_family(pids[0])
        family.update({p: t for p in pids[1:] if (t := _started_ticks_or_none(p)) is not None})
        with contextlib.suppress(ProcessLookupError):  # it quit on its own a moment ago
            os.kill(pids[0], signal.SIGTERM)
        worker = threading.Thread(target=make_sure_closed, args=(spec.get("label", name), family), daemon=True)
        worker.start()
    with edit_timers() as t:
        t.pop(name, None)
    return worker


def _started_ticks_or_none(pid):
    try:
        return _started_ticks(pid)
    except (OSError, ValueError, IndexError):
        return None


def process_family(root):
    """{pid: start ticks} for a process and everything under it. The start ticks tell a later
    check whether a PID still means the same process rather than a new one that reused the number."""
    kids = {}
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            with contextlib.suppress(OSError, ValueError, IndexError):
                ppid = int(d.joinpath("stat").read_text().rsplit(")", 1)[1].split()[1])
                kids.setdefault(ppid, []).append(int(d.name))
    family, todo = {}, [root]
    while todo:
        pid = todo.pop()
        with contextlib.suppress(OSError, ValueError, IndexError):
            family[pid] = _started_ticks(pid)
            todo += kids.get(pid, [])
    return family


QUIT_WAIT = 15  # seconds a program gets to quit politely before it's made to


def make_sure_closed(label, family):
    """Some apps ignore the polite quit (OpenWhispr hides to the tray), or quit and leave helpers behind
    (OpenWhispr's speech model, 1.3 GB). Whatever of the family is still up after QUIT_WAIT gets TERM,
    then KILL."""
    def alive():
        out = []
        for pid, ticks in family.items():
            with contextlib.suppress(OSError, ValueError, IndexError):
                if _started_ticks(pid) == ticks and Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0] != "Z":
                    out.append(pid)
        return out
    time.sleep(QUIT_WAIT)
    for sig in (signal.SIGTERM, signal.SIGKILL):
        left = alive()
        if not left:
            return
        print(f"{label}: {len(left)} process(es) still up after quit; sending {sig.name}", flush=True)
        for pid in left:
            with contextlib.suppress(OSError):
                os.kill(pid, sig)
        time.sleep(5)


def programs_state():
    out = []
    idle = idle_seconds()
    for n, s in PROGRAMS.items():
        running = program_running(s)
        entry = timers().get(n) if running else None
        at = entry.get("at") if isinstance(entry, dict) else None
        out.append({"id": n, "label": s.get("label", n), "note": s.get("note", ""), "running": running,
                    "closes_in": max(0, int(at - time.time())) if at else None,
                    "idle_minutes": s.get("close_when_idle_minutes"),
                    "idle_left": idle_left(s, idle) if running else None, "icon": icon_url("program", n)})
    return out


# ---- icons ---------------------------------------------------------------------------------
# Each app and program gets a real icon on the panel, cached in ICONS as "<kind>-<id>.<ext>".
# Programs: their own .desktop file's icon, from the icon theme. Docker apps: `icon:` in apps.yaml
# (a file path, a URL, or a name from the homelab dashboard-icons set, e.g. `jellyfin`), else the
# icon its main web page declares, fetched once the app is up. Nothing found: the panel shows a letter.
ICONS = Path.home() / ".cache/dock/icons"
DASHBOARD_ICONS = "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons@main/png/{}.png"
IMAGE_TYPES = {".png": "image/png", ".svg": "image/svg+xml", ".ico": "image/x-icon", ".jpg": "image/jpeg", ".webp": "image/webp"}
ICON_DIRS = [Path.home() / ".local/share/icons/hicolor", Path("/usr/share/icons/hicolor")]


def cached_icon(kind, name):
    return next((p for p in ICONS.glob(f"{kind}-{name}.*") if p.suffix in IMAGE_TYPES), None)


def save_icon(kind, name, data, ext):
    if ext not in IMAGE_TYPES or not data:
        return
    ICONS.mkdir(parents=True, exist_ok=True)
    for old in ICONS.glob(f"{kind}-{name}.*"):
        old.unlink()
    tmp = ICONS / f".{kind}-{name}{ext}"
    tmp.write_bytes(data)
    os.replace(tmp, ICONS / f"{kind}-{name}{ext}")


def ext_of(content_type, url):
    for ext, t in IMAGE_TYPES.items():
        if content_type.startswith(t):
            return ext
    return ".jpg" if url.lower().endswith(".jpeg") else Path(urlparse(url).path).suffix.lower()


def fetch(url, limit=2 * 1024 ** 2):
    with urlopen(Request(url, headers={"User-Agent": "dock-icons"}), timeout=8) as r:
        return r.read(limit), r.headers.get("Content-Type", "")


def theme_icon(icon):
    """The biggest file for an icon-theme name: a scalable SVG, else the largest PNG."""
    if icon.startswith("/"):
        return Path(icon) if Path(icon).exists() else None
    best = None
    for root in ICON_DIRS:
        for f in root.glob(f"*/apps/{icon}.*"):
            size = 10 ** 4 if f.parent.parent.name == "scalable" else int(f.parent.parent.name.split("x")[0] or 0)
            if f.suffix in IMAGE_TYPES and (not best or size > best[0]):
                best = (size, f)
    pix = Path("/usr/share/pixmaps")
    return best[1] if best else next((f for f in pix.glob(f"{icon}.*") if f.suffix in IMAGE_TYPES), None)


def program_icon_file(name):
    spec = PROGRAMS[name]
    if spec.get("icon"):
        return theme_icon(str(Path(spec["icon"]).expanduser()) if "/" in spec["icon"] else spec["icon"])
    for d in (Path.home() / ".local/share/applications", Path("/usr/share/applications")):
        desktop = d / f"{spec['launch']}.desktop"
        with contextlib.suppress(OSError):
            for line in desktop.read_text().splitlines():
                if line.startswith("Icon="):
                    return theme_icon(line[5:].strip())
    return None


def page_icon_url(page):
    """The best icon a web page declares (apple-touch-icon first, it's the big one), else /favicon.ico."""
    html = fetch(page, 512 * 1024)[0].decode("utf-8", "replace")
    links = re.findall(r"<link\b[^>]*>", html, re.I)
    for want in ("apple-touch-icon", "icon"):
        for tag in links:
            rel = re.search(r'rel=["\']?([^"\'>]+)', tag, re.I)
            href = re.search(r'href=["\']?([^"\'\s>]+)', tag, re.I)
            if rel and href and want in rel.group(1).lower().split():
                return urljoin(page, href.group(1))
    return urljoin(page, "/favicon.ico")


def find_app_icon(name):
    """Fetch and cache one app's icon; True once it has one."""
    spec = APPS[name]
    want = spec.get("icon")
    if want and not want.startswith(("http://", "https://")) and ("/" in want or "." in want):
        f = Path(want).expanduser()
        if not f.is_absolute() and "compose" in spec:
            f = Path(spec["compose"]["dir"]).expanduser() / f
        if f.exists():
            save_icon("app", name, f.read_bytes(), f.suffix.lower())
            return True
        return False
    if want:
        url = want if want.startswith("http") else DASHBOARD_ICONS.format(want)
    else:
        main = next((w for w in spec.get("web", []) if w.get("port")), None)
        if not main:
            return False
        url = page_icon_url(f"http://127.0.0.1:{main['port']}/")
    data, ctype = fetch(url)
    if ctype.startswith("text/"):  # e.g. a single-page app answering /favicon.ico with its HTML
        return False
    save_icon("app", name, data, ext_of(ctype, url))
    return bool(cached_icon("app", name))


def icons_loop():
    """Programs' icons are local, so they're found straight away. Apps without one are tried every
    10 minutes, as their pages only answer while they're up."""
    for name in PROGRAMS:
        with contextlib.suppress(Exception):  # an odd icon folder (e.g. hicolor/symbolic) must not end this thread
            if not cached_icon("program", name) and (f := program_icon_file(name)):
                save_icon("program", name, f.read_bytes(), f.suffix.lower())
    while True:
        for name in APPS:
            if not cached_icon("app", name):
                with contextlib.suppress(Exception):  # a page that's down or odd just means "try later"
                    find_app_icon(name)
        time.sleep(600)


def icon_url(kind, name):
    f = cached_icon(kind, name)
    return f"/api/icon/{kind}/{name}?v={int(f.stat().st_mtime)}" if f else None


# ---- phone panel ---------------------------------------------------------------------------

busy = {}  # app -> "starting" | "stopping" | "restarting" | "restarting <container>" | "error: ..."
busy_lock = threading.Lock()  # two taps landing together must not both start the same job


def in_progress(app):
    return bool(busy.get(app)) and not busy[app].startswith("error")


def run_in_background(app, label, work):
    with busy_lock:
        if in_progress(app):
            return False
        busy[app] = label

    def go():
        try:
            work()
            busy.pop(app, None)
        except Exception as e:  # shown in the panel until the next action, and kept in the journal
            print(f"{app}: {label} failed: {e}", flush=True)
            busy[app] = f"error: {e}"

    threading.Thread(target=go, daemon=True).start()
    return True


VERB = {"on": "starting", "off": "stopping", "restart": "restarting", "update": "updating"}


def snapshot():
    every = inspect_all()
    host = host_stats(every)
    built = (docker_disk() or {}).get("created", {})
    rows, claimed = [], set()
    for app, spec in APPS.items():
        cs = sorted(members(app, every), key=lambda c: c["name"])
        claimed.update(c["name"] for c in cs)
        containers = [{**{k: c[k] for k in ("name", "running", "state", "health", "started", "finished",
                                            "error", "exit", "restarts", "image")},
                       "built": built.get(c["image_id"]), "update": has_update(c), **stats.get(c["name"], {})}
                      for c in cs]
        rows.append({
            "id": app, "label": spec.get("label", app), "note": spec.get("note", ""), "icon": icon_url("app", app),
            **status(app, every), "busy": busy.get(app), "web": links(app, every),
            "gpu": bool(spec.get("gpu")), "gpu_clash": gpu_clash(app, every, host["gpu"]),
            "can_update": "compose" in spec, "updates": [c["name"] for c in containers if c["update"]],
            "containers": containers,
        })
    return {"host": host, "apps": rows, "programs": programs_state(), "unlisted": sorted(set(every) - claimed)}


ICON = HERE / "icon.png"
MANIFEST = json.dumps({"name": "Linux Remote", "short_name": "Linux Remote", "start_url": "/", "display": "standalone",
                       "background_color": "#000000", "theme_color": "#000000",
                       "icons": [{"src": "/icon.png", "sizes": "180x180", "type": "image/png"}]})


class Panel(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def log_request(self, code="-", size="-"):
        if self.path == "/api/state" and code == 200:
            return
        print(f"{self.command} {self.path} {code} host={self.headers.get('Host')} ua={self.headers.get('User-Agent', '')[:70]}", flush=True)

    def reply(self, code, body, ctype="application/json", cookie=None, cache="no-store"):
        data = body if isinstance(body, bytes) else body.encode()
        try:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", cache)
            if ctype == IMAGE_TYPES[".svg"]:  # an SVG opened on its own could run script on the panel's address
                self.send_header("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'")
            if cookie:
                self.send_header("Set-Cookie", cookie)
            self.end_headers()
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            pass  # the phone closed the page or lost signal mid-reply; nothing to answer

    def guarded(self):
        """Answers the request here if the lock owns it: /api/auth*, or an API call from a locked phone."""
        path = urlparse(self.path).path
        if path == lock.AUTH_PREFIX or path.startswith(lock.AUTH_PREFIX + "/"):
            try:
                size = min(max(int(self.headers.get("Content-Length") or 0), 0), 64_000)
            except ValueError:
                size = 0
            status, body, cookie = LOCK.handle(self.command, path, self.headers, self.rfile.read(size))
            self.reply(status, json.dumps(body), cookie=cookie)
            return True
        if LOCK.blocks(path, self.headers):
            self.reply(401, json.dumps({"locked": True}))
            return True
        return False

    def host_ok(self):
        # Exact names only, so a DNS-rebinding page can't talk to the panel.
        host = self.headers.get("Host", "").rsplit(":", 1)[0]
        return host in ("127.0.0.1", "localhost", tailscale()["host"])

    def do_GET(self):
        if not self.host_ok():
            return self.reply(403, "{}")
        if self.guarded():
            return
        url = urlparse(self.path)
        parts = url.path.strip("/").split("/")
        if url.path == "/api/state":
            last_poll[0] = time.time()
            return self.reply(200, json.dumps(snapshot()))
        if len(parts) == 3 and parts[:2] == ["api", "logs"] and owner(parts[2], inspect_all()):
            try:
                n = min(max(int((parse_qs(url.query).get("lines") or ["300"])[0]), 50), 2000)
            except ValueError:
                n = 300
            return self.reply(200, logs(parts[2], n), "text/plain; charset=utf-8")
        if len(parts) == 4 and parts[:2] == ["api", "icon"] and parts[3] in {"app": APPS, "program": PROGRAMS}.get(parts[2], ()):
            if f := cached_icon(parts[2], parts[3]):  # the ?v= in its link changes when the file does
                return self.reply(200, f.read_bytes(), IMAGE_TYPES[f.suffix], cache="private, max-age=31536000, immutable")
        if url.path in ("/", "/index.html"):
            return self.reply(200, (HERE / "panel.html").read_bytes(), "text/html; charset=utf-8")
        if url.path == "/icon.png" and ICON.exists():
            return self.reply(200, ICON.read_bytes(), "image/png")
        if url.path == "/lock.js":
            return self.reply(200, (HERE / "lock.js").read_bytes(), "text/javascript; charset=utf-8")
        if url.path == "/sw.js":
            return self.reply(200, (HERE / "sw.js").read_bytes(), "text/javascript; charset=utf-8")
        if url.path == "/manifest.webmanifest":
            return self.reply(200, MANIFEST, "application/manifest+json")
        self.reply(404, "{}")

    def do_POST(self):
        # Custom header forces a CORS preflight, which this server never answers, so other
        # websites open in a browser on this PC can't toggle anything.
        if not self.host_ok():
            return self.reply(403, "{}")
        if self.guarded():  # the lock's own POSTs carry X-Lock instead, checked in lock.py
            return
        if self.headers.get("X-Dock") != "1":
            return self.reply(403, "{}")
        parts = urlparse(self.path).path.strip("/").split("/")
        # api/apps/<id|all>/<on|off|restart|update>
        if len(parts) == 4 and parts[:2] == ["api", "apps"] and parts[3] in VERB:
            if parts[2] == "all" or parts[2] in APPS:
                act = parts[3]
                names = resolve(parts[2])
                if act == "update":
                    names = [n for n in names if "compose" in APPS[n]]
                started = [run_in_background(n, VERB[act], lambda n=n: turn(n, act)) for n in names]
                return self.reply(202 if any(started) else 409, "{}")
        # api/programs/<id>/<open|close|later>
        if len(parts) == 4 and parts[:2] == ["api", "programs"] and parts[2] in PROGRAMS and parts[3] in ("open", "close", "later"):
            try:
                {"open": open_program, "close": close_program, "later": push_back}[parts[3]](parts[2])
            except RuntimeError as e:
                return self.reply(409, json.dumps({"error": str(e)}))
            except Exception as e:
                return self.reply(500, json.dumps({"error": str(e)}))
            return self.reply(202, "{}")
        # api/containers/<name>/restart
        if len(parts) == 4 and parts[:2] == ["api", "containers"] and parts[3] == "restart":
            app = owner(parts[2], inspect_all())
            if app:
                ok = run_in_background(app, f"restarting {parts[2]}", lambda: sh(["docker", "restart", parts[2]]))
                return self.reply(202 if ok else 409, "{}")
        self.reply(404, "{}")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "panel":
        threading.Thread(target=stats_loop, daemon=True).start()
        threading.Thread(target=updates_loop, daemon=True).start()
        threading.Thread(target=timers_loop, daemon=True).start()
        threading.Thread(target=icons_loop, daemon=True).start()
        print(f"panel on http://127.0.0.1:{PORT}", flush=True)
        ThreadingHTTPServer(("127.0.0.1", PORT), Panel).serve_forever()
    elif cmd == "status":
        every = inspect_all()
        for app in APPS:
            s = status(app, every)
            print(f"{app:16} {s['state']:8} {s['running']}/{s['total']}" + (f"  down: {', '.join(s['down'])}" if s["down"] else ""))
    elif cmd == "urls":
        every = inspect_all()
        for app in APPS:
            for l in links(app, every):
                print(f"{l['label']:16} {'up  ' if l['up'] else 'off '} phone: {l['phone'] or '(PC only)':42} pc: {l['pc']}")
        ts = tailscale()
        if ts["host"]:
            print(f"{'This panel':16}      phone: {ts['serve'].get(PORT, '(not served)')}")
    elif cmd == "updates":
        check_updates()
        every, found = inspect_all(), False
        for app in APPS:
            for c in members(app, every):
                if has_update(c):
                    found = True
                    print(f"{app:16} {c['name']:24} {c['image']}  newer image out  (dock update {app})")
        for ref, err in updates["errors"].items():
            print(f"couldn't check {ref}: {err}", file=sys.stderr)
        if not found:
            print("Every image is up to date (images built on this machine aren't checked).")
    elif cmd in VERB and len(sys.argv) == 3:
        for app in resolve(sys.argv[2]):
            if cmd == "update" and "compose" not in APPS[app]:
                continue
            if cmd == "on":
                if clash := gpu_clash(app, inspect_all()):
                    print(f"warning: {', '.join(clash)} is also on the GPU; both may not fit on the card", file=sys.stderr)
            print(f"{cmd} {app} ...", flush=True)
            try:
                turn(app, cmd)
            except RuntimeError as e:
                sys.exit(f"{app}: {e}")
    elif cmd in ("open", "close", "later") and len(sys.argv) == 3:
        name = sys.argv[2].lower()
        if name not in PROGRAMS:
            sys.exit(f"unknown program {name!r}; programs: {', '.join(PROGRAMS)}")
        label = PROGRAMS[name].get("label", name)
        if cmd == "open":
            print(f"opening {label}" if open_program(name) else f"{label} is already open")
        elif cmd == "close":
            print(f"closing {label}", flush=True)
            if worker := close_program(name):
                worker.join()  # stay until it's really gone, or the follow-up check dies with this command
        else:
            try:
                push_back(name)
            except RuntimeError as e:
                sys.exit(str(e))
            print(f"{label} now closes at {datetime.fromtimestamp(timers()[name]['at']):%H:%M}")
    elif cmd == "programs":
        for p in programs_state():
            left = f"  closes in {p['closes_in'] // 60} min" if p["closes_in"] is not None else ""
            if p["idle_left"] is not None:
                left += f"  closes in {p['idle_left'] // 60} min unless the PC is used"
            print(f"{p['id']:12} {'open  ' if p['running'] else 'closed'}  {p['label']}{left}")
    elif cmd == "password":
        lock.main([str(LOCK.path)])
        print("The panel picks it up straight away; no restart needed.")
    elif cmd == "logs" and len(sys.argv) in (3, 4):
        print(logs(sys.argv[2], int(sys.argv[3]) if len(sys.argv) == 4 else 200), end="")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
